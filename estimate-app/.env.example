# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Public base URL used in links sent to customers (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # optional now; the app uses the address it is served from

# --- Optional (without these, "Send" opens the owner's own text/email app) ---
# Model for voice/text -> line items. Fast + cheap is the point.
ANTHROPIC_MODEL=claude-haiku-5-5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
RESEND_FROM="Estimates <estimates@yourdomain.com>"
